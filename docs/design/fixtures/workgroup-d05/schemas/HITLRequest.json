{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dagents.local/workgroup-d05/HITLRequest.json",
  "title": "HITLRequest",
  "type": "object",
  "required": [
    "hitl_id",
    "workgroup_id",
    "kind",
    "actor_run_id",
    "turn_id",
    "tool_call_id",
    "status",
    "prompt",
    "home_node_id"
  ],
  "properties": {
    "hitl_id": {
      "type": "string",
      "pattern": "^ht_[0-9a-z]{26}$"
    },
    "workgroup_id": {
      "type": "string",
      "pattern": "^wg_[0-9a-z]{26}$"
    },
    "kind": {
      "enum": [
        "information_request",
        "execution_approval"
      ]
    },
    "actor_run_id": {
      "type": "string",
      "pattern": "^rn_[0-9a-z]{26}$"
    },
    "turn_id": {
      "type": "string",
      "pattern": "^tn_[0-9a-z]{26}$"
    },
    "tool_call_id": {
      "type": "string"
    },
    "command_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^cmd_[0-9a-z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload_hash": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "pending",
        "resolved",
        "expired",
        "canceled"
      ]
    },
    "prompt": {
      "type": "string"
    },
    "home_node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "execution_approval"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "command_id",
          "payload_hash"
        ]
      }
    }
  ]
}
