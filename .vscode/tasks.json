{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dagents-node: background",
      "type": "shell",
      "command": "go run ./node/cmd/dagents-node -config packaging/agent-client/config.example.yaml",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "dagents-node",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "config loaded",
          "endsPattern": "agent node listening"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "close": false
      }
    }
  ]
}
