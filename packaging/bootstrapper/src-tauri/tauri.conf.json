{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DAgents Setup",
  "version": "0.1.0",
  "identifier": "com.dagents.setup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "安装 DAgents",
        "width": 920,
        "height": 620,
        "minWidth": 840,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "DAgents 本地助手安装向导",
    "longDescription": "现代安装向导：引导选择目录后调用 Inno Setup 静默安装包完成落地。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/*"]
  },
  "plugins": {}
}
