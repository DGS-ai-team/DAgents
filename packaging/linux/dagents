#!/usr/bin/env sh
set -eu

DAGENTS_HOME="${DAGENTS_HOME:-/opt/dagents/backend}"

show_help() {
  cat <<EOF
Usage:
  dagents chat               Start interactive Textual TUI chat
  dagents show session       List active queue and persisted sqlite sessions
  dagents delete session ID  Delete persisted sqlite session (not in queue)
  dagents serve              Start the Agent API backend
  dagents register-center    Start the Register Center
  dagents doctor             Check installed files
  dagents version            Print version information

Environment:
  Set DAGENTS_HOME to override the installation directory.
  Set DAGENTS_API_BASE to choose the chat backend URL.
  Copy .env.example to .env in $DAGENTS_HOME to customize host, port, model, and provider settings.
EOF
}

cmd="${1:-chat}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "$cmd" in
  chat)
    if [ ! -x "$DAGENTS_HOME/dagents-cli" ]; then
      echo "[dagents] dagents-cli was not found or is not executable in $DAGENTS_HOME" >&2
      exit 1
    fi
    cd "$DAGENTS_HOME"
    exec "$DAGENTS_HOME/dagents-cli" chat "$@"
    ;;
  serve|api)
    if [ ! -x "$DAGENTS_HOME/dagents-api" ]; then
      echo "[dagents] dagents-api was not found or is not executable in $DAGENTS_HOME" >&2
      exit 1
    fi
    cd "$DAGENTS_HOME"
    exec "$DAGENTS_HOME/dagents-api" "$@"
    ;;
  register-center)
    if [ ! -x "$DAGENTS_HOME/dagents_register_center" ]; then
      echo "[dagents] dagents_register_center was not found or is not executable in $DAGENTS_HOME" >&2
      exit 1
    fi
    cd "$DAGENTS_HOME"
    exec "$DAGENTS_HOME/dagents_register_center" "$@"
    ;;
  doctor)
    echo "DAgents installation: $DAGENTS_HOME"
    [ -x "$DAGENTS_HOME/dagents-cli" ] && echo "[ok] dagents-cli found" || echo "[missing] dagents-cli"
    [ -x "$DAGENTS_HOME/dagents-api" ] && echo "[ok] dagents-api found" || echo "[missing] dagents-api"
    [ -x "$DAGENTS_HOME/dagents_register_center" ] && echo "[ok] dagents_register_center found" || echo "[missing] dagents_register_center"
    [ -f "$DAGENTS_HOME/.env" ] && echo "[ok] .env found" || echo "[info] .env not found; defaults and .env.example will be used"
    [ -d "$DAGENTS_HOME/.runtime" ] && echo "[ok] .runtime found" || echo "[missing] .runtime"
    ;;
  version)
    if [ -x "$DAGENTS_HOME/dagents-cli" ]; then
      exec "$DAGENTS_HOME/dagents-cli" version
    fi
    echo "DAgents"
    if [ -f "$DAGENTS_HOME/README.md" ]; then
      sed -n '1p' "$DAGENTS_HOME/README.md"
    fi
    ;;
  help|--help|-h)
    show_help
    ;;
  *)
    echo "[dagents] Unknown command: $cmd" >&2
    echo >&2
    show_help >&2
    exit 1
    ;;
esac
