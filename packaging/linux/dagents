#!/usr/bin/env bash
# DAgents Local Assistant 命令行入口（对齐 packaging/windows/dagents.cmd）。
set -euo pipefail

# install.sh 会在 BIN_DIR（如 /usr/local/bin）创建指向 PREFIX/dagents 的符号链接；
# 须沿链接解析真实路径，否则 ROOT 会落在 BIN_DIR 导致查找 bin/dagents-node 失败。
dagents_script_dir() {
  local src="${BASH_SOURCE[1]}"
  while [[ -L "${src}" ]]; do
    local dir
    dir="$(cd -P "$(dirname "${src}")" && pwd)"
    src="$(readlink "${src}")"
    [[ "${src}" != /* ]] && src="${dir}/${src}"
  done
  cd -P "$(dirname "${src}")" && pwd
}

ROOT="$(dagents_script_dir)"
export DAGENTS_HOME="${ROOT}"

die() {
  echo "[dagents] $*" >&2
  exit 1
}

# 对齐 packaging/windows/dagents.cmd 的 pushd：Node 的 fs_root（默认 ./.runtime）相对进程 cwd 解析。
cd "${ROOT}" || die "cannot cd to ${DAGENTS_HOME}"

CFG="${DAGENTS_CONFIG:-config.yaml}"
if [[ ! -f "${ROOT}/${CFG}" && -f "${ROOT}/config.example.yaml" ]]; then
  cp "${ROOT}/config.example.yaml" "${ROOT}/config.yaml"
  CFG="config.yaml"
fi
if [[ ! -f "${ROOT}/.env" && -f "${ROOT}/.env.example" ]]; then
  cp "${ROOT}/.env.example" "${ROOT}/.env"
fi

BIN="${ROOT}/bin"
NODE_PID_FILE="${ROOT}/.runtime/node.pid"
BROWSER_PID_FILE="${ROOT}/.runtime/browser.pid"
NODE_STOP_TIMEOUT_SEC=15
# set -u 下空数组 "${PARSED_ARGS[@]}" 会 unbound；须预先声明并在无额外参数时分支 exec。
WITHNODE=0
PARSED_ARGS=()

require_bin() {
  local name="$1"
  [[ -x "${BIN}/${name}" ]] || die "${BIN}/${name} was not found in ${DAGENTS_HOME}"
}

probe_node() {
  "${BIN}/dagents-client" -config "${ROOT}/${CFG}" probe >/dev/null 2>&1
}

write_node_pid() {
  local pid="$1"
  mkdir -p "${ROOT}/.runtime"
  echo "${pid}" >"${NODE_PID_FILE}"
}

clear_node_pid() {
  rm -f "${NODE_PID_FILE}"
}

# 查找与本安装目录/config 匹配的 dagents-node 进程（无 pid 文件时兜底）。
find_node_pids() {
  local cfg_abs="${ROOT}/${CFG}"
  local pattern="${BIN}/dagents-node"
  if command -v pgrep >/dev/null 2>&1; then
    pgrep -f "${pattern}.*-config[[:space:]]+${cfg_abs}" 2>/dev/null || true
  fi
}

pid_alive() {
  local pid="$1"
  [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null
}

stop_node_process() {
  local pid="$1"
  if ! pid_alive "${pid}"; then
    return 0
  fi
  kill -TERM "${pid}" 2>/dev/null || true
  local waited=0
  while pid_alive "${pid}"; do
    sleep 1
    waited=$((waited + 1))
    if [[ "${waited}" -ge "${NODE_STOP_TIMEOUT_SEC}" ]]; then
      kill -KILL "${pid}" 2>/dev/null || true
      sleep 1
      break
    fi
  done
}

shutdown_node() {
  require_bin dagents-client
  if ! probe_node; then
    clear_node_pid
    echo "[dagents] node is not running"
    return 0
  fi

  local pid=""
  if [[ -f "${NODE_PID_FILE}" ]]; then
    pid="$(tr -d '[:space:]' <"${NODE_PID_FILE}")"
  fi
  if pid_alive "${pid}"; then
    echo "[dagents] stopping node (pid=${pid})"
    stop_node_process "${pid}"
  else
    local pids
    pids="$(find_node_pids)"
    if [[ -n "${pids}" ]]; then
      echo "[dagents] stopping node (pids=${pids//$'\n'/, })"
      while IFS= read -r p; do
        [[ -n "${p}" ]] && stop_node_process "${p}"
      done <<<"${pids}"
    fi
  fi

  clear_node_pid
  if probe_node; then
    die "node still responds to probe after shutdown; check .runtime/logs/node.err.log"
  fi
  echo "[dagents] node stopped"
}

probe_browser() {
  curl -fsS --max-time 2 http://127.0.0.1:18766/health >/dev/null 2>&1
}

write_browser_pid() {
  local pid="$1"
  mkdir -p "${ROOT}/.runtime"
  echo "${pid}" >"${BROWSER_PID_FILE}"
}

clear_browser_pid() {
  rm -f "${BROWSER_PID_FILE}"
}

find_browser_pids() {
  local cfg_abs="${ROOT}/${CFG}"
  local pattern="${BIN}/dagents-browser"
  if command -v pgrep >/dev/null 2>&1; then
    pgrep -f "${pattern}.*--config[[:space:]]+${cfg_abs}" 2>/dev/null || true
  fi
}

stop_browser_process() {
  stop_node_process "$1"
}

shutdown_browser() {
  if ! probe_browser; then
    clear_browser_pid
    echo "[dagents] browser service is not running"
    return 0
  fi

  local pid=""
  if [[ -f "${BROWSER_PID_FILE}" ]]; then
    pid="$(tr -d '[:space:]' <"${BROWSER_PID_FILE}")"
  fi
  if pid_alive "${pid}"; then
    echo "[dagents] stopping browser service (pid=${pid})"
    stop_browser_process "${pid}"
  else
    local pids
    pids="$(find_browser_pids)"
    if [[ -n "${pids}" ]]; then
      echo "[dagents] stopping browser service (pids=${pids//$'\n'/, })"
      while IFS= read -r p; do
        [[ -n "${p}" ]] && stop_browser_process "${p}"
      done <<<"${pids}"
    fi
  fi

  clear_browser_pid
  if probe_browser; then
    die "browser service still responds after shutdown; check .runtime/logs/browser.err.log"
  fi
  echo "[dagents] browser service stopped"
}

start_browser_background() {
  require_bin dagents-browser
  mkdir -p "${ROOT}/.runtime/logs"
  echo "[dagents] starting browser service in background (logs: .runtime/logs/browser.log)"
  nohup "${BIN}/dagents-browser" --config "${ROOT}/${CFG}" \
    >>"${ROOT}/.runtime/logs/browser.log" 2>>"${ROOT}/.runtime/logs/browser.err.log" &
  write_browser_pid "$!"
}

wait_browser_ready() {
  local wait=0
  while ! probe_browser; do
    sleep 1
    wait=$((wait + 1))
    if [[ "${wait}" -ge 30 ]]; then
      die "browser service did not become ready within 30s (see .runtime/logs/browser.err.log)"
    fi
  done
}

start_browser_default() {
  if probe_browser; then
    echo "[dagents] browser service already running"
    return 0
  fi
  start_browser_background
  wait_browser_ready
  echo "[dagents] browser service is ready"
}

start_node_background() {
  require_bin dagents-node
  mkdir -p "${ROOT}/.runtime/logs"
  echo "[dagents] starting node in background (logs: .runtime/logs/node.log)"
  nohup "${BIN}/dagents-node" -config "${ROOT}/${CFG}" \
    >>"${ROOT}/.runtime/logs/node.log" 2>>"${ROOT}/.runtime/logs/node.err.log" &
  write_node_pid "$!"
}

print_webui_url() {
  local url="http://127.0.0.1:18765/ui/"
  if [[ -x "${ROOT}/scripts/webui-url.sh" ]]; then
    url="$("${ROOT}/scripts/webui-url.sh" "${ROOT}/${CFG}")"
  elif [[ -f "${ROOT}/${CFG}" ]]; then
    local port
    port="$(grep -A10 '^listen:' "${ROOT}/${CFG}" 2>/dev/null | grep -E '^[[:space:]]+port:' | head -1 | sed -E 's/[^0-9]*([0-9]+).*/\1/' || true)"
    [[ -n "${port}" ]] && url="http://127.0.0.1:${port}/ui/"
  fi
  echo "[dagents] Web UI: ${url}"
}

wait_node_ready() {
  require_bin dagents-client
  local wait=0
  while ! probe_node; do
    sleep 1
    wait=$((wait + 1))
    if [[ "${wait}" -ge 30 ]]; then
      die "node did not become ready within 30s (see .runtime/logs/node.err.log)"
    fi
  done
}

start_node_default() {
  require_bin dagents-client
  if probe_node; then
    echo "[dagents] node already running"
    print_webui_url
    return 0
  fi
  start_node_background
  wait_node_ready
  echo "[dagents] node is ready"
  print_webui_url
}

restart_node() {
  shutdown_node
  start_node_background
  wait_node_ready
  echo "[dagents] node restarted"
  print_webui_url
}

ensure_node() {
  require_bin dagents-client
  if probe_node; then
    return 0
  fi
  start_node_background
  wait_node_ready
}

parse_withnode() {
  WITHNODE=0
  PARSED_ARGS=()
  for arg in "$@"; do
    if [[ "${arg}" == "--withnode" ]]; then
      WITHNODE=1
    else
      PARSED_ARGS+=("${arg}")
    fi
  done
}

cmd_doctor() {
  echo "DAgents installation: ${DAGENTS_HOME}"
  local ok=1 name
  for name in dagents-node dagents-client dagents-cli dagents-browser; do
    if [[ -x "${BIN}/${name}" ]]; then
      echo "[ok] bin/${name}"
    else
      echo "[missing] bin/${name}"
      ok=0
    fi
  done
  if [[ -f "${ROOT}/config.yaml" ]]; then
    echo "[ok] config.yaml"
  else
    echo "[info] config.yaml not found; copy config.example.yaml config.yaml"
  fi
  if [[ -d "${ROOT}/.runtime" ]]; then
    echo "[ok] .runtime"
  else
    echo "[missing] .runtime"
    ok=0
  fi
  return "${ok}"
}

read_app_version() {
  local v=""
  if [[ -f "${ROOT}/VERSION" ]]; then
    v="$(tr -d '[:space:]' < "${ROOT}/VERSION")"
  fi
  if [[ -z "${v}" ]] && [[ -x "${BIN}/dagents-node" ]]; then
    v="$("${BIN}/dagents-node" version 2>/dev/null | awk '{print $NF}' || true)"
  fi
  if [[ -z "${v}" ]]; then
    v="unknown"
  fi
  printf '%s\n' "${v}"
}

cmd_version() {
  local ver
  ver="$(read_app_version)"
  echo "DAgents ${ver}"
}

cmd_update() {
  local force=0 check=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force|-f) force=1 ;;
      --check) check=1 ;;
      --from-client) ;;
      *)
        die "unknown option: $1"
        ;;
    esac
    shift
  done

  require_bin dagents-client
  if ! probe_node; then
    die "node is not running; start with: dagents node"
  fi

  if [[ "${check}" -eq 1 ]]; then
    "${BIN}/dagents-client" -config "${ROOT}/${CFG}" update --check
    return $?
  fi

  local tmp_pkg
  tmp_pkg="$(mktemp "${ROOT}/.runtime/dagents-update.XXXXXX.tar.gz")"
  local extra=()
  [[ "${force}" -eq 1 ]] && extra+=(--force)

  set +e
  "${BIN}/dagents-client" -config "${ROOT}/${CFG}" update --output "${tmp_pkg}" "${extra[@]}"
  local rc=$?
  set -e

  if [[ "${rc}" -eq 3 ]]; then
    rm -f "${tmp_pkg}"
    echo "[dagents] already up to date"
    return 0
  fi
  if [[ "${rc}" -ne 0 ]]; then
    rm -f "${tmp_pkg}"
    return "${rc}"
  fi
  if [[ ! -s "${tmp_pkg}" ]]; then
    rm -f "${tmp_pkg}"
    die "update download produced an empty file"
  fi

  shutdown_node

  local staging
  staging="$(mktemp -d "${ROOT}/.runtime/dagents-update-staging.XXXXXX")"
  tar -xzf "${tmp_pkg}" -C "${staging}"
  local bundle=""
  bundle="$(find "${staging}" -mindepth 1 -maxdepth 1 -type d | head -1)"
  if [[ -z "${bundle}" || ! -f "${bundle}/install.sh" ]]; then
    rm -rf "${staging}" "${tmp_pkg}"
    die "invalid update package (missing install.sh)"
  fi

  echo "[dagents] applying update from ${bundle##*/}"
  (cd "${bundle}" && ./install.sh --prefix "${ROOT}" --overwrite-policy --keep-policy)

  rm -rf "${staging}" "${tmp_pkg}"
  restart_node
  echo "[dagents] update complete"
}

cmd_help() {
  cat <<'EOF'
Usage:
  dagents chat [--withnode]       Textual TUI (Python; rich UI)
  dagents tui [--withnode] [--plain]  Go bubbletea TUI (default full-screen; --plain for line REPL)
  dagents node                    Start Agent Node in background (default; waits until ready)
  dagents node shutdown           Stop background Node
  dagents node restart            Stop then start Node in background
  dagents node --foreground       Start Node in foreground (blocks terminal)
  dagents node --no-wait          Background start without waiting for probe
  dagents browser                 Start browser-use service in background (browser.enabled)
  dagents browser stop            Stop browser-use service
  dagents browser --foreground    Run browser service in foreground
  dagents doctor                  Check installed files
  dagents version                 Print version information
  dagents version --check         Check for updates (via Manage Release Hub)
  dagents update [--check]        Download and apply latest release
  dagents update --force          Apply without confirmation prompt

Web UI (browser Client, embedded in dagents-node):
  After `dagents node`, open http://127.0.0.1:<listen.port>/ui/ (default port 18765).
  Disable with ui.enabled: false in config.yaml. No separate UI package required.

Options:
  --withnode     Probe Node first; start it in background if not running, then launch client
  --foreground   Run Node in foreground (blocks terminal)
  --no-wait      Background start without waiting for probe (--background alias)

Config:
  Edit config.yaml (LLM, listen, agent_id). Created from config.example.yaml on first run.
  A2A / Registry: deploy Manage separately (packaging/manage/README.md).
  CLI override: DAGENTS_CONFIG or DAGENTS_NODE_ENDPOINT
EOF
}

if [[ $# -eq 0 ]]; then
  require_bin dagents-cli
  exec "${BIN}/dagents-cli" chat --config "${ROOT}/${CFG}"
fi

case "$1" in
  help|-h|--help)
    cmd_help
    ;;
  chat)
    shift
    parse_withnode "$@"
    if [[ "${WITHNODE}" -eq 1 ]]; then
      ensure_node
    fi
    require_bin dagents-cli
    if ((${#PARSED_ARGS[@]} > 0)); then
      exec "${BIN}/dagents-cli" chat --config "${ROOT}/${CFG}" "${PARSED_ARGS[@]}"
    else
      exec "${BIN}/dagents-cli" chat --config "${ROOT}/${CFG}"
    fi
    ;;
  tui)
    shift
    parse_withnode "$@"
    if [[ "${WITHNODE}" -eq 1 ]]; then
      ensure_node
    fi
    require_bin dagents-client
    if ((${#PARSED_ARGS[@]} > 0)); then
      exec "${BIN}/dagents-client" -config "${ROOT}/${CFG}" tui "${PARSED_ARGS[@]}"
    else
      exec "${BIN}/dagents-client" -config "${ROOT}/${CFG}" tui
    fi
    ;;
  node)
    shift
    case "${1:-}" in
      shutdown|stop)
        shutdown_node
        exit 0
      ;;
      restart)
        restart_node
        exit 0
      ;;
      --foreground|-f)
        shift
        require_bin dagents-node
        exec "${BIN}/dagents-node" -config "${ROOT}/${CFG}" "$@"
      ;;
      --no-wait|--background)
        if probe_node; then
          echo "[dagents] node already running"
          exit 0
        fi
        start_node_background
        exit 0
      ;;
      "")
        start_node_default
        exit 0
      ;;
      *)
        require_bin dagents-node
        exec "${BIN}/dagents-node" -config "${ROOT}/${CFG}" "$@"
      ;;
    esac
    ;;
  browser)
    shift
    case "${1:-}" in
      shutdown|stop)
        shutdown_browser
        exit 0
      ;;
      --foreground|-f)
        shift
        require_bin dagents-browser
        exec "${BIN}/dagents-browser" --config "${ROOT}/${CFG}" "$@"
      ;;
      --no-wait|--background)
        if probe_browser; then
          echo "[dagents] browser service already running"
          exit 0
        fi
        start_browser_background
        exit 0
      ;;
      "")
        start_browser_default
        exit 0
      ;;
      *)
        require_bin dagents-browser
        exec "${BIN}/dagents-browser" --config "${ROOT}/${CFG}" "$@"
      ;;
    esac
    ;;
  doctor)
    cmd_doctor
    exit $?
    ;;
  update)
    shift
    cmd_update "$@"
    exit $?
    ;;
  version)
    shift
    if [[ "${1:-}" == "--check" ]]; then
      require_bin dagents-client
      if ! probe_node; then
        die "node is not running; start with: dagents node"
      fi
      "${BIN}/dagents-client" -config "${ROOT}/${CFG}" update --check
      exit $?
    fi
    cmd_version
    exit 0
    ;;
  *)
    require_bin dagents-cli
    exec "${BIN}/dagents-cli" "$@"
    ;;
esac
