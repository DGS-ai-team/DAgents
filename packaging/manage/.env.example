# cp .env.example .env
COMPOSE_PROJECT_NAME=dagents-manage
MANAGE_PORT=8020
MANAGE_VERSION=0.5.4
MANAGE_IMAGE=dagents-manage:0.5.4
# 持久化路径（默认均在 manage-data volume 的 /data 下，一般无需改）
