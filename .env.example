# 复制为 .env 后填写（.env 已加入 .gitignore，勿提交密钥）
# cp .env.example .env
#
# 本文件仅保留当前代码实际使用的配置项，按“基础必配 / 常用可选 / 高级可选”分组。

## ---------------------------
## 1) 基础必配：LLM
## ---------------------------
LLM_API_KEY=
LLM_API_BASE=https://api.siliconflow.cn/v1
LLM_MODEL=Pro/deepseek-ai/DeepSeek-V3.2
LLM_TIMEOUT=120
LLM_ENABLE_THINKING=true
LLM_THINKING_BUDGET=256
LLM_MAX_TOOL_LOOPS=16

## ---------------------------
## 2) 常用运行配置：API / CLI / 队列
## ---------------------------
# API 服务监听地址（run_agent_api.py）；CLI 的 HTTP base URL 由 host/port 推导（0.0.0.0 绑定则客户端用 127.0.0.1）
API_HOST=127.0.0.1
API_PORT=8000
# 允许跨域访问的来源（逗号分隔）
API_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 队列（0 表示不限制）
MAX_QUEUE_SIZE=0
AGENT_MAX_ACTIVE_SESSION_QUEUES=3

# 触发器控制面：启用后可通过 API 管理触发器，并由调度器按条件唤起 Agent
TRIGGERS_ENABLED=true
TRIGGER_SCHEDULER_POLL_SECONDS=5

## ---------------------------
## 3) Register Center 服务自身（run_register_center.py）
## ---------------------------
REGISTER_CENTER_HOST=0.0.0.0
REGISTER_CENTER_PORT=8010
# 可选：启用 Register Center JSON 文件持久化；未配置则仅使用进程内内存
# REGISTER_CENTER_STORE_PATH=.runtime/register_center/agents.json

## ---------------------------
## 4) 常用可选：skills / 协作 / 观测
## ---------------------------
# skills 动态注入
# AGENT_SKILLS_ENABLED=true
# 是否允许 agent 自主创建/修改 skills（默认 false）
# AGENT_SKILLS_ALLOW_CREATE=false
# AGENT_SKILLS_MAX_IN_PROMPT=3

# 是否启用 SqliteMessageStore 持久化（路径固定为 <运行根>/.runtime/memory/session.sqlite3，见 runtime_layout）
# AGENT_SESSION_STORE_ENABLED=true

# 原始 OpenAI 消息 JSONL 按条记录（目录固定 .runtime/history；摘要压缩替换整段 messages 不会写入）
# AGENT_RAW_MESSAGE_HISTORY_ENABLED=true

# Agent 间协作（register_center + peer tools）
# REGISTRY_URL=http://127.0.0.1:8010
# DISCOVERY_GROUPS=team-a,team-b
# AGENT_PUBLIC_BASE_URL=http://127.0.0.1:8000
# AGENT_REGISTRY_TTL_SECONDS=60
# AGENT_PEER_CACHE_TTL_SECONDS=60
# AGENT_PEER_DELIVERY_MODE=direct
# AGENT_PEER_HTTP_RETRY_ATTEMPTS=2
# AGENT_PEER_STREAM_TIMEOUT_SECONDS=60
# AGENT_PEER_BROADCAST_STREAM_TIMEOUT_SECONDS=20
# AGENT_PEER_SHARED_TOKEN=
# AGENT_TOOL_APPROVAL_MODE=rule
# 工具级 / shell 级审批策略：固定路径 <运行根>/.runtime/policy/tool.approval.txt 与 <运行根>/.runtime/policy/shell/（不由环境变量覆盖）

# 指标开关
# METRICS_ENABLED=true

# 应用与 uvicorn 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL（DEBUG 会以 repr 打印每条 OpenAI 流式 chunk）
# APP_LOG_LEVEL=INFO

## ---------------------------
## 5) 高级可选：性能/兼容/存储
## ---------------------------
# 本地 agent_id / sqlite / skills / 原始消息 JSONL / 审批策略等均在 **`<运行根>/.runtime/`** 下固定子路径（见 `app/config/runtime_layout.py`，不由环境变量改路径）。

# summary 压缩阈值（估算 token）
# SUMMARY_COMPRESSION_SILENT_TRIGGER_TOKENS=4000
# SUMMARY_COMPRESSION_BLOCKING_TRIGGER_TOKENS=8000

# 流式响应末尾是否请求 usage（部分网关可能不支持）
# LLM_STREAM_INCLUDE_USAGE=true

# shell 工具输出解码编码（Windows 中文环境可设 gbk 或 cp936）
# BASH_OUTPUT_ENCODING=utf-8

# 文件工具单次返回体积上限（UTF-8 字节；不由模型传参）
# FS_TOOL_READ_MAX_BYTES=3000
# FS_TOOL_SEARCH_MAX_BYTES=8000

# Agent 实例标识（未配置时自动生成并持久化到 <运行根>/.runtime/agent/agent_id）
# AGENT_ID=

# 队列淘汰策略：达到活跃上限时，仅淘汰闲置超过阈值的会话（秒）
# AGENT_SESSION_IDLE_EVICT_SECONDS=300
