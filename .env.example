# 复制为 .env 后填写（.env 已加入 .gitignore，勿提交密钥）
# cp .env.example .env
#
# 键名与默认值定义见 app/config/settings.py → Settings

# 主对话模型（OpenAI 兼容，如 SiliconFlow）
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_API_BASE=https://api.siliconflow.cn/v1
LLM_MODEL=Pro/deepseek-ai/DeepSeek-V3.2
LLM_TIMEOUT=120
LLM_ENABLE_THINKING=true
LLM_THINKING_BUDGET=256
LLM_MAX_TOOL_LOOPS=16
# summary 静默压缩触发阈值（估算 token）；每轮 handle_message 开始时达到阈值会并行启动压缩
# SUMMARY_COMPRESSION_SILENT_TRIGGER_TOKENS=4000
# summary 显式阻塞压缩触发阈值（估算 token）；每轮 handle_message 开始时达到阈值会先串行压缩再处理消息
# SUMMARY_COMPRESSION_BLOCKING_TRIGGER_TOKENS=8000
# 流式响应末尾是否请求 usage（用于 Prometheus token 指标）；不支持的网关可设为 false
# LLM_STREAM_INCLUDE_USAGE=true

# Prometheus：`GET /metrics`；本地/测试可关闭
# METRICS_ENABLED=true

# 队列（MVP）
# 0 表示不限制；>0 时队列满会拒绝入队
MAX_QUEUE_SIZE=0
# 同时活跃的 session 队列上限（每个 session 一条独立消费队列）
AGENT_MAX_ACTIVE_SESSION_QUEUES=3
# 达上限时淘汰闲置会话：最后活动时间超过该秒数（默认 5 分钟）的 session 可被移除；0 表示不自动淘汰
# AGENT_SESSION_IDLE_EVICT_SECONDS=300

# CLI 模式（MVP）
# - api：stdin -> FastAPI（默认，推荐）
# - 当前仅支持 api/http（方案二）
AGENT_CLI_MODE=api
AGENT_API_BASE=http://127.0.0.1:8000
# API 服务监听地址（run_agent_api.py）
API_HOST=127.0.0.1
API_PORT=8000
# 允许跨域访问的前端来源（逗号分隔）；本地 Vite 默认 5173
API_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 前端请求后端地址（Vite）
VITE_API_BASE_URL=http://127.0.0.1:8000
# Agent 实例标识：不填时会从 AGENT_ID_FILE_PATH 读取；若文件不存在则自动生成 UUID 并写入文件
# AGENT_ID=
# AGENT_ID_FILE_PATH=.runtime/agent/agent_id

# Agent 间协作（register-center + peer tools）
# REGISTRY_URL=http://127.0.0.1:8010
# DISCOVERY_GROUPS=team-a,team-b
# AGENT_PUBLIC_BASE_URL=http://127.0.0.1:8000
# AGENT_PEER_CACHE_TTL_SECONDS=60
# AGENT_PEER_DELIVERY_MODE=direct
# AGENT_PEER_STREAM_TIMEOUT_SECONDS=60
# AGENT_PEER_BROADCAST_STREAM_TIMEOUT_SECONDS=20
# 全局工具审批模式：always（总是审批）/ never（永不审批）/ rule（按 tool.py 规则函数判断）
# AGENT_TOOL_APPROVAL_MODE=rule

# 会话上下文 sqlite（OpenAI runtime 与 SqliteMessageStore）；不设则用默认路径；显式设为空可关闭
# AGENT_SESSION_STORE_PATH=.runtime/memory/session.sqlite3

# 可选：旧变量名兼容（仅当未设置 LLM_API_KEY 时生效）
# OPENAI_API_KEY=
