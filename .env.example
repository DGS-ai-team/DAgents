# 复制为 .env 后按需填写（.env 已加入 .gitignore，勿提交密钥）
# cp .env.example .env
#
# Go Node / Client 的主配置在 config.yaml（由 config.example.yaml 复制）。
# 本文件仅保留 Register Center 与 CLI 仍读取的环境变量。

## ---------------------------
## Register Center（可选 A2A；run_register_center.py / dagents_register_center）
## ---------------------------
REGISTER_CENTER_HOST=0.0.0.0
REGISTER_CENTER_PORT=8010
# 启用 JSON 持久化（相对安装/运行根目录）
# REGISTER_CENTER_STORE_PATH=.runtime/register_center/agents.json
# 节点间鉴权共享令牌（可选）
# AGENT_PEER_SHARED_TOKEN=

## ---------------------------
## CLI / Client 覆盖（可选）
## ---------------------------
# 共用 YAML 路径（默认探测 config.yaml / packaging/agent-client/config.example.yaml）
# DAGENTS_CONFIG=config.yaml
# 无 YAML 时的 Node HTTP 地址回退
# DAGENTS_NODE_ENDPOINT=http://127.0.0.1:18765
# DAGENTS_API_BASE=http://127.0.0.1:18765
# 覆盖 node_id（否则由 .runtime/node/node_id 或 YAML 种子生成）
# 旧环境变量 AGENT_ID 仍可作为升级回退，但新部署请使用 NODE_ID
# NODE_ID=
# AGENT_ID=

## ---------------------------
## Python CLI 日志（可选）
## ---------------------------
# DAGENTS_LOG_LEVEL=INFO
# DAGENTS_LOG_DIR=
# DAGENTS_HOME=
