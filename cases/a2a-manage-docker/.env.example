# 复制为本目录 .env 后按需填写（.env 已 gitignore，勿提交密钥）
# cp .env.example .env

# Compose 变量替换 + node-a/node-b 容器环境
MANAGE_PORT=8020
MANAGE_URL=http://127.0.0.1:8020
NODE_A_PORT=18765
NODE_B_PORT=18766

# Node LLM：true=mock（默认）；false=真实 API（需填写下方 LLM_*）
LLM_MOCK=true

# 注入 node-a / node-b 容器；config/node-*.yaml 通过 api_key_env 读取 LLM_API_KEY
# 真实联调：LLM_MOCK=false，node-a（A2A 合规）与 node-b（TUI）均走 LLM
LLM_PROVIDER=openai
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# verify.sh 等待 Task 完成的最长秒数
POLL_SECONDS=90
