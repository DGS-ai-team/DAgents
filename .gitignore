policy.yaml
policy.local.yaml
packaging/agent-client/config.yaml
packaging/agent-client/config.local.yaml
packaging/agent-client/policy.yaml
packaging/agent-client/policy.local.yaml

# local runtime/state files
.runtime/
logs/
# 仅忽略仓库根下名为 history 的目录，避免误伤 `app/harness/history/` 源码包。
/history/
*.sqlite3

# private planning docs
docs/private-enterprise-positioning.md

# editor / IDE
.cursor/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json

# local worktrees
.worktrees/

# frontend/tooling artifacts (for split-repo collaboration)
.pnpm-store/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
openapi.json

# Go (Agent Node + Client)
node/dagents-node
client/dagents-client
**/go.sum
**/__debug_bin*

# Node Web UI (npm ci in CI / build.sh)
node/webui/frontend/node_modules/
node/internal/webui/static/*
!node/internal/webui/static/.gitkeep

# Manage Console (npm ci in CI / build.sh)
manage/console/frontend/node_modules/
manage/console/static/*
!manage/console/static/.gitkeep

# PyInstaller / 本地打包中间产物（与 CI `dist/`、`bundle/` 布局一致，避免误提交二进制）
dist/
dist-installer/
build/
bundle/
deb-root/
rpm-build/

# Tauri Setup 向导（packaging/bootstrapper）
packaging/bootstrapper/node_modules/
packaging/bootstrapper/dist/
packaging/bootstrapper/src-tauri/target/
packaging/bootstrapper/src-tauri/resources/*.exe
