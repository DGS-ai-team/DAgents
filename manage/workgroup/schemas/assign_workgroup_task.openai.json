{
  "type": "function",
  "function": {
    "name": "assign_workgroup_task",
    "description": "Assign work to one workgroup member and wait until it reaches a terminal status. Multiple assignments to different members may run concurrently; the same member remains single-flight. v1 member tools are limited to read_file on workspace-relative paths (e.g. README); do not ask members to open host absolute paths.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_purpose",
        "member_id",
        "instruction"
      ],
      "properties": {
        "call_purpose": {
          "type": "string",
          "description": "Required. Briefly explain the purpose of this tool call; shown in the workgroup progress UI."
        },
        "member_id": {
          "type": "string",
          "pattern": "^mb_[0-9a-z]{26}$"
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000,
          "description": "Task for the member. For file reads, prefer relative paths under the member workspace."
        }
      }
    }
  },
  "result_schema": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assign_id",
          "status",
          "summary",
          "error_code"
        ],
        "properties": {
          "assign_id": {
            "type": "string",
            "pattern": "^as_[0-9a-z]{26}$"
          },
          "status": {
            "const": "succeeded"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "error_code": {
            "type": "null"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assign_id",
          "status",
          "summary",
          "error_code"
        ],
        "properties": {
          "assign_id": {
            "type": "string",
            "pattern": "^as_[0-9a-z]{26}$"
          },
          "status": {
            "enum": [
              "failed",
              "canceled",
              "indeterminate"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "error_code": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    ]
  },
  "invariants": [
    "at_most_one_active_assign_per_member",
    "tool_result_exactly_one_per_tool_call_id",
    "timeline_actor_final_text_deduped_by_assign_id_for_leader_context"
  ]
}
