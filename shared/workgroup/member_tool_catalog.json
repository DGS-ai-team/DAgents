{
  "schema_version": 1,
  "groups": [
    {"id": "fs", "label": "文件系统"},
    {"id": "bash", "label": "Shell"}
  ],
  "tools": [
    {
      "id": "read_file",
      "label": "读文件",
      "group": "fs",
      "group_label": "文件系统",
      "hint": "read_file",
      "default": true,
      "side_effect": "fs_read",
      "description": "Read a text file from the member workspace. path must be relative to the workspace root; absolute host paths are denied.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "description": "Relative path inside the member workspace"}
        },
        "required": ["path"]
      }
    },
    {
      "id": "show_image",
      "label": "展示图片",
      "group": "fs",
      "group_label": "文件系统",
      "hint": "show_image",
      "default": true,
      "side_effect": "fs_read",
      "description": "Show an existing image from the member workspace in the UI (jpg/png/gif/webp, max 10MB).",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "description": "Relative image path"},
          "caption": {"type": "string", "description": "Optional caption"}
        },
        "required": ["path"]
      }
    },
    {
      "id": "read_image",
      "label": "读图片",
      "group": "fs",
      "group_label": "文件系统",
      "hint": "read_image（需启用多模态）",
      "default": true,
      "side_effect": "fs_read",
      "description": "Read an image from the member workspace for multimodal understanding (jpg/png/gif/webp, max 10MB).",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "description": "Relative image path"},
          "detail": {"type": "string", "enum": ["auto", "low", "high"]}
        },
        "required": ["path"]
      }
    },
    {
      "id": "write_file",
      "label": "写文件",
      "group": "fs",
      "group_label": "文件系统",
      "hint": "write_file",
      "default": true,
      "side_effect": "fs_write",
      "description": "Write (overwrite) a text file inside the member workspace. path must be relative; prefer read_file first when editing existing files.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "description": "Relative path inside the member workspace"},
          "content": {"type": "string", "description": "Full file contents to write"}
        },
        "required": ["path", "content"]
      }
    },
    {
      "id": "glob_files",
      "label": "列目录",
      "group": "fs",
      "group_label": "文件系统",
      "hint": "glob_files",
      "default": true,
      "side_effect": "fs_read",
      "description": "List paths under the member workspace matching a glob. Does not read file contents. directory is relative (use . for workspace root).",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "directory": {
            "type": "string",
            "description": "Start directory relative to workspace (required; use . for root)"
          },
          "glob_pattern": {
            "type": "string",
            "description": "Glob relative to directory, e.g. *.md or **/*.txt"
          },
          "offset": {"type": "integer", "minimum": 0},
          "max_results": {"type": "integer", "minimum": 1},
          "include_dirs": {"type": "boolean"}
        },
        "required": ["directory", "glob_pattern"]
      }
    },
    {
      "id": "grep_file",
      "label": "单文件搜索",
      "group": "fs",
      "group_label": "文件系统",
      "hint": "grep_file",
      "default": true,
      "side_effect": "fs_read",
      "description": "Search line contents inside a single file in the member workspace (regex or literal).",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "description": "Relative file path"},
          "pattern": {"type": "string", "description": "Line match expression"},
          "index_offset": {"type": "integer", "minimum": 0},
          "count_limit": {"type": "integer", "minimum": 1},
          "context_lines": {"type": "integer", "minimum": 0},
          "case_sensitive": {"type": "boolean"},
          "literal": {"type": "boolean"}
        },
        "required": ["path", "pattern"]
      }
    },
    {
      "id": "grep_files",
      "label": "多文件搜索",
      "group": "fs",
      "group_label": "文件系统",
      "hint": "grep_files",
      "default": true,
      "side_effect": "fs_read",
      "description": "Search line contents across files under a directory in the member workspace.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "directory": {"type": "string", "description": "Start directory (use . for root)"},
          "pattern": {"type": "string", "description": "Line match expression"},
          "glob_pattern": {"type": "string", "description": "Optional file glob, default **/*"},
          "hit_offset": {"type": "integer", "minimum": 0},
          "max_hits": {"type": "integer", "minimum": 1},
          "max_files": {"type": "integer", "minimum": 1},
          "context_lines": {"type": "integer", "minimum": 0},
          "case_sensitive": {"type": "boolean"},
          "literal": {"type": "boolean"}
        },
        "required": ["directory", "pattern"]
      }
    },
    {
      "id": "search_replace",
      "label": "替换内容",
      "group": "fs",
      "group_label": "文件系统",
      "hint": "search_replace",
      "default": true,
      "side_effect": "fs_write",
      "description": "Exact substring replace in an existing text file. Prefer read_file first to verify context.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "description": "Relative file path"},
          "old_string": {"type": "string", "description": "Exact substring to find"},
          "new_string": {"type": "string", "description": "Replacement (empty deletes)"},
          "replace_all": {"type": "boolean"}
        },
        "required": ["path", "old_string", "new_string"]
      }
    },
    {
      "id": "bash_run",
      "label": "Shell",
      "group": "bash",
      "group_label": "Shell",
      "hint": "bash_run（工作区内；无额外沙箱，默认不勾选）",
      "default": false,
      "side_effect": "shell",
      "description": "Run a shell command with cwd defaulting to the member workspace root. On Windows prefer PowerShell syntax; elsewhere prefer bash.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {"type": "string", "description": "Shell command string"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
          "cwd": {"type": "string", "description": "Optional relative cwd under workspace"},
          "shell_type": {"type": "string", "enum": ["bash", "cmd", "powershell"]}
        },
        "required": ["command"]
      }
    }
  ]
}
